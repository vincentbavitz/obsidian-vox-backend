{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2020",
    "baseUrl": "src",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    // Allow for global names in Bun; eg Bun.serve
    "types": ["bun-types"]
  }
}
