[Unit]
Description=Docker Obsidian Voice Transcription
Requires=docker.service
After=docker.service
StartLimitIntervalSec=60

[Service]
WorkingDirectory=/home/[USER]/obsidian-vox
# CPU inference (default):
ExecStart=/usr/bin/docker compose up
# GPU inference (Vulkan — AMD, Intel, NVIDIA): comment out the line above and uncomment below:
#ExecStart=/usr/bin/docker compose -f docker-compose-gpu.yaml up
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
Restart=on-failure
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
